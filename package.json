{
  "name": "hatch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "geo": "node scripts/build-geo.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts",
    "build:all": "npm run build && npm run build:single",
    "preview": "vite preview",
    "shoot": "node scripts/shoot.mjs screenshots p2",
    "budget": "node scripts/budget.mjs",
    "icons": "node scripts/logo.mjs && node scripts/icons.mjs",
    "og": "npm run build:single && node scripts/og.mjs",
    "check": "npm run build && npm run build:single && npm run budget && npm run shoot && npm run mobile && npm run desktop && npm run fine",
    "mobile": "node scripts/mobile.mjs screenshots/mobile",
    "desktop": "node scripts/desktop.mjs screenshots/desktop",
    "fine": "node scripts/fine.mjs screenshots/fine"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/extensions": "9.4.0",
    "@deck.gl/geo-layers": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@luma.gl/core": "9.4.0",
    "@luma.gl/engine": "9.4.0",
    "@luma.gl/gpgpu": "9.4.0",
    "@luma.gl/shadertools": "9.4.0",
    "@luma.gl/webgl": "9.4.0",
    "h3-js": "4.5.0"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/topojson-client": "3.1.5",
    "playwright": "1.56.1",
    "terser": "5.44.0",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "us-atlas": "3.0.1",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.4"
  },
  "overrides": {
    "@luma.gl/core": "9.4.0",
    "@luma.gl/engine": "9.4.0",
    "@luma.gl/gpgpu": "9.4.0",
    "@luma.gl/shadertools": "9.4.0",
    "@luma.gl/webgl": "9.4.0",
    "@luma.gl/gltf": "9.4.0",
    "@luma.gl/webgpu": "9.4.0"
  }
}
